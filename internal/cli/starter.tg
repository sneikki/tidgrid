# Starter vocabulary written by `tidgrid init`. Plain and neutral: replace it.
# Raw values live only in the token groups and breakpoints; everything else uses them by name.

# Project: where the stylesheet goes and which files are scanned for classes.
project(out = "src/styles/tidgrid.css", scan = ["src"], prefix = "tg")

# Breakpoints: ascending. Atoms can be prefixed with them (md:tg-gap(md)).
breakpoints(sm = "40em", md = "64em", lg = "80em")

# Colour: greys only. A hue is the project's decision: add it when the look is chosen.
color = tokens("color", {
    "ground": "#ffffff",
    "raised": "#f5f5f5",
    "sunken": "#ebebeb",
    "ink": "#1a1a1a",
    "muted": "#6b6b6b",
    "line": "#d0d0d0",
})

# Space: the gap and padding scale, six steps.
space = tokens("space", {
    "xs": "0.25rem",
    "sm": "0.5rem",
    "md": "1rem",
    "lg": "1.5rem",
    "xl": "2rem",
    "xxl": "3rem",
})

# Size: widths and heights.
size = tokens("size", {
    "full": "100%",
    "prose": "36rem",
    "measure": "72rem",
})

# Border: a hairline, used by roles that need one.
border = tokens("border", {
    "hair": "1px",
})

# Radius: corners. Square by default.
radius = tokens("radius", {
    "none": "0",
    "sm": "0.25rem",
})

# Font: system fonts only.
font = tokens("font", {
    "sans": "system-ui, -apple-system, 'Segoe UI', sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, monospace",
})

# Text: font sizes for the text roles.
text = tokens("text", {
    "body": "1rem",
    "label": "0.875rem",
    "heading": "1.375rem",
    "title": "2rem",
})

# Motion: durations for transitions.
motion = tokens("motion", {
    "quick": "120ms",
})

# Reset: removes every browser default look, so only this file gives one. "minimal" fixes only.
tidiness("full")

# Base rules for bare elements.
element("body", css = {
    "background": color.ground,
    "color": color.ink,
    "font-family": font.sans,
    "font-size": text.body,
    "line-height": "1.5",
})

# Links: the text's colour, underlined so they still read as links.
element("a", css = {
    "color": color.ink,
    "text-decoration": "underline",
})

# Roles. Uncomment a role when a page uses it: `tidgrid check` fails on a role nothing uses.

# Surfaces: a panel that sits on the page. Raised is the normal panel, sunken is a well.
# role("surface", "raised",
#     use = "A panel holding one group of related content. Use for most boxes; at most a few per view.",
#     css = {
#         "background": color.raised,
#         "border-radius": radius.sm,
#     })

