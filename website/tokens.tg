# Every colour is a pair: light-dark(light, dark). The browser picks by the
# reader's system setting, switched on by color-scheme on html (index.tg).
color = tokens("color", {
    "ink": "light-dark(#32495d, #d7e2ec)",
    "ink-soft": "light-dark(#4d708e, #a3bcd1)",
    "muted": "light-dark(#92adc4, #7b96ac)",
    "paper": "light-dark(#ffffff, #11171d)",
    "raised": "light-dark(#ffffff, #171f27)",
    "tint": "light-dark(#f7f7f7, #18212a)",
    "drawer": "light-dark(#f8f8f8, #151c24)",
    "drawer-edge": "light-dark(#ececec, #27323d)",
    "edge": "light-dark(#f0f0f0, #232d38)",
    "sand": "light-dark(#f8f3ed, #222e3a)",
    "sand-ink": "light-dark(#c3a888, #d2b892)",
    "accent": "light-dark(#da526b, #ec6b82)",
    "pass": "light-dark(#1d7a62, #6fd0b0)",
    "keyword": "light-dark(#fa8383, #ff9b9b)",
    "shade": "light-dark(#00000011, #00000055)",
    "shade-deep": "light-dark(#00000021, #00000088)",
    "code-ground": "light-dark(#fafafa, #0c1116)",
    "code-edge": "light-dark(#f2f2f2, #1e2832)",
    "code-ink": "light-dark(#32495d, #c5d2de)",
    # Syntax colours come from the page's own hues (slate blue, the pink accent),
    # not from an editor theme: sections in the accent, keys blue, strings mint.
    "syn-comment":"light-dark(#5f7488, #6f879b)",
    "syn-keyword": "light-dark(#6a4fc0, #b7a6f2)",
    "syn-tag": "light-dark(#c2334f, #ec6b82)",
    "syn-literal": "light-dark(#b3366f, #f2a0b1)",
    "syn-string": "light-dark(#23755f, #a9d6c4)",
    "syn-attr": "light-dark(#2a6aa0, #8fb8de)",
    "syn-title": "light-dark(#1f5fa8, #7fb6f0)",
    "syn-builtin": "light-dark(#0f7385, #7fd1de)",
})

